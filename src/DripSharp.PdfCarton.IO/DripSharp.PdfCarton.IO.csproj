<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>DripSharp.PdfCarton.IO</AssemblyName>
    <RootNamespace>DripSharp.PdfCarton.IO</RootNamespace>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PackageId>DripSharp.PdfCarton.IO</PackageId>
    <Version>3.0.8-dripsharp.0</Version>
    <Title>PdfCarton I/O</Title>
    <Description>Apache PDFBox random-access and stream I/O for .NET, mechanically translated by DripSharp. This package is an independent translation and is not affiliated with, endorsed by, or sponsored by the Apache Software Foundation.</Description>
    <Authors>Vibeformer</Authors>
    <Copyright>Portions Copyright The Apache Software Foundation and other upstream contributors; see NOTICE.txt.</Copyright>
    <PackageTags>pdf pdfbox io random-access dotnet pdfcarton</PackageTags>
    <PackageProjectUrl>https://pdfbox.apache.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/apache/pdfbox.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryCommit>9286e47d89d6877005c9d2d0f2fd38793a62519a</RepositoryCommit>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DripSharp.PdfCarton</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DripSharp.PdfCarton.Preflight</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DripSharp.PdfCarton.Tests</_Parameter1>
    </AssemblyAttribute>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <None Include="src/Legal/LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
    <None Include="src/Legal/NOTICE.txt" Pack="true" PackagePath="NOTICE.txt" />
  </ItemGroup>
</Project>
