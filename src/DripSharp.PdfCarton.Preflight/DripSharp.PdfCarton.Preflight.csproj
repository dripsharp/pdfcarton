<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>DripSharp.PdfCarton.Preflight</AssemblyName>
    <RootNamespace>DripSharp.PdfCarton.Preflight</RootNamespace>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <PackageId>DripSharp.PdfCarton.Preflight</PackageId>
    <Version>3.0.8-alpha.1</Version>
    <Title>PdfCarton Preflight</Title>
    <Description>Apache Preflight PDF/A validation APIs for .NET, mechanically translated by DripSharp. This package is an independent translation and is not affiliated with, endorsed by, or sponsored by the Apache Software Foundation.</Description>
    <Authors>Isak Sky</Authors>
    <Copyright>Portions Copyright The Apache Software Foundation and other upstream contributors; see NOTICE.txt.</Copyright>
    <PackageTags>pdf pdfbox pdfa validation preflight dotnet pdfcarton</PackageTags>
    <PackageProjectUrl>https://github.com/dripsharp/pdfcarton</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dripsharp/pdfcarton.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
    <SourceRoot Include="$(MSBuildProjectDirectory)/" RepositoryUrl="https://github.com/dripsharp/pdfcarton.git" SourceControl="git" RevisionId="$(RepositoryCommit)" SourceLinkUrl="https://raw.githubusercontent.com/dripsharp/pdfcarton/$(RepositoryCommit)/src/DripSharp.PdfCarton.Preflight/*" />
    <ProjectReference Include="../DripSharp.PdfCarton.Xmp/DripSharp.PdfCarton.Xmp.csproj" />
    <ProjectReference Include="../DripSharp.PdfCarton/DripSharp.PdfCarton.csproj" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DripSharp.PdfCarton.Tests</_Parameter1>
    </AssemblyAttribute>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="src/Legal/LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
    <None Include="src/Legal/NOTICE.txt" Pack="true" PackagePath="NOTICE.txt" />
  </ItemGroup>
</Project>
