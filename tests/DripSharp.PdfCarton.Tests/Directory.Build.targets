<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>DripSharp.PdfCarton.Tests.AutoGenerated.XunitAutoGeneratedEntryPoint</StartupObject>
    <GenerateProgramFile>false</GenerateProgramFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CS0168;CS0219;CS8632;CA1416;xUnit1013</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Fixtures/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
